# General System Config
NODE_ENV=development

# Core Infrastructure Services
DATABASE_URL=postgresql://cyberlab:cyberlab_secret@localhost:5432/cyberlab
REDIS_URL=redis://localhost:6379

# Service URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
LAB_ORCHESTRATOR_URL=http://localhost:5000

# Client Facing Public Envs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Security (Secrets MUST be changed in Production)
SESSION_SECRET=super_secret_dev_key_replace_in_prod
